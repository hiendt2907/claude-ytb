# TTS
TTS_PROVIDER=xkiro         # xkiro | f5 | vieneu | vixtts | edge | elevenlabs
ALLOW_CLOUD_PROVIDERS=true  # bắt buộc khi dùng xKiro/Edge/ElevenLabs
XKIRO_API_KEY=              # lấy từ xKiro; không commit key thật
XKIRO_TTS_URL=https://api.xkiro.com/v1/audio/speech
XKIRO_MODEL=xkiro-voice
XKIRO_VOICE=confident-male-vietnamese
XKIRO_TIMEOUT_SEC=120
XKIRO_MAX_RETRIES=3
ELEVENLABS_API_KEY=

# Nhịp ngắt nghỉ giọng đọc (ms) — không đọc một lèo
PAUSE_COMMA_MS=250         # nghỉ sau dấu phẩy / ; :
PAUSE_SENTENCE_MS=400      # nghỉ sau . ! ? …
PAUSE_SEGMENT_MS=500       # nghỉ giữa các segment

# Hiệu năng (tốc độ sản xuất) — hạ xuống 1 nếu gặp rate-limit/máy yếu
EDGE_TTS_WORKERS=1         # mặc định tuần tự; tăng chỉ khi Edge TTS không throttling
BROLL_DOWNLOAD_WORKERS=4   # số file B-roll Pexels tải song song
BROLL_ALLOW_DOWNLOADS=false # local-first: chỉ bật true khi thực sự cần tải Pexels mới
X264_PRESET_WORK=veryfast  # preset encode clip trung gian (bị re-encode lại ở bước cuối)
X264_PRESET_FINAL=medium   # preset encode file .mp4 cuối (chất lượng như trước)

# Content profile — mỗi chủ đề là một thư mục tự chứa config/prompt/cast/assets.
# CLI `ytb batch start --profile <id>` ghi id vào từng queue item; batch run
# resolve lại profile riêng cho mỗi subprocess, không cần sửa code/settings.
CONTENT_PROFILE_ID=one-cup-cafe-6h
CONTENT_PROFILES_DIR=profiles

# Render
RENDER_PROVIDER=ai         # ai (mặc định, rollback 2026-08-24) = compose B-roll THẬT
                           # từ asset catalog/cache local đã tải sẵn — KHÔNG gọi Pexels
                           # online (BROLL_ALLOW_DOWNLOADS=false mặc định). Renderer
                           # story = asset nhân vật local của content profile.
                           # "motion" (Pillow+FFmpeg vẽ hình học) đã bị gỡ khỏi codebase.
IMAGE_PROVIDER=pillow      # dùng cho thumbnail/overlay; không dùng làm video chính
# "pexels" = TÊN NGUỒN GỐC asset (video licensed từ Pexels), KHÔNG phải "gọi
# Pexels API online". Với BROLL_ALLOW_DOWNLOADS=false, mọi B-roll lấy từ
# assets/broll/ + asset_catalog.json local — không cần PEXELS_API_KEY.
BROLL_STRATEGY=pexels      # chỉ áp dụng khi RENDER_PROVIDER=ai
VIDEO_PROVIDER=pexels      # chỉ dùng cho `ytb batch doctor --local`, không nằm trong đường render thật
COMFYUI_URL=http://127.0.0.1:8188              # chỉ cần khi IMAGE_PROVIDER=flux
FLUX_CHECKPOINT_NAME=flux1-dev-fp8.safetensors # chỉ cần khi IMAGE_PROVIDER=flux
ORIENTATION=portrait       # portrait (Short dọc) | landscape (clip ngang)
# CHỈ bắt buộc khi BROLL_ALLOW_DOWNLOADS=true (opt-in tải thêm B-roll mới).
# Local-only mode (mặc định) không cần key này.
PEXELS_API_KEY=
SHOW_CAPTIONS=false        # false = KHÔNG chữ chạy trong video (mặt video sạch)

# Wan local video generation: không bật mặc định trên Mac M4 Pro 24GB.
# Chỉ set các biến này khi dùng máy NVIDIA/VRAM phù hợp và BROLL_STRATEGY=local_video|mixed.
WAN_MODEL_PATH=
WAN_CLI=wan2.2

# LLM — ideation chỉ dùng xKiro/DeepSeek V4 Pro. MacBook chỉ chạy workflow/
# pipeline; khi xKiro lỗi, lệnh dừng minh bạch và không fallback provider/model.
LLM_PROVIDER=xkiro
# Explicit local E2E profile: Long = 3–4 minutes / ~4.8k–6.4k chars.
# Leave false/unset for production 12–15 minute Longs.
YTB_E2E_TEST=false
# xKiro LLM — endpoint /v1/chat/completions riêng biệt với TTS, chung API key
# XKIRO_API_KEY ở trên. Model được pin rõ để provenance nội dung nhất quán.
XKIRO_LLM_URL=https://api.xkiro.com/v1/chat/completions
XKIRO_LLM_MODEL=deepseek/deepseek-v4-pro

# YouTube Data API (OAuth client tải từ Google Cloud Console)
YOUTUBE_API_KEY=           # key đọc công khai: research trending (videos.list mostPopular)
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# Paths
ASSETS_DIR=assets
OUTPUT_DIR=assets/output
PROJECTS_DIR=assets/projects  # checkpoint DAG: <slug>/project.json per video
QUALITY_STT_MODEL_PATH=        # optional existing local Faster-Whisper model directory; empty = no STT, never a model name/URL

# Behaviour
DRY_RUN=true               # true = không upload thật, chỉ render local

# Telegram (cổng duyệt kịch bản ở khâu ideation)
TELEGRAM_BOT_TOKEN=        # tạo bot qua @BotFather
TELEGRAM_CHAT_ID=          # chat id của mày (hỏi @userinfobot)
TELEGRAM_APPROVAL=true     # true = chờ duyệt qua Telegram trước khi render
TELEGRAM_PROGRESS=true     # bắn tiến độ từng video (bắt đầu + link) khi ytb batch run

# Listener — daemon nghe lệnh Telegram (ra lệnh từ xa, máy Mac luôn mở).
# Mỗi lệnh chạy 1 phiên `claude -p` mới ⇒ context sạch. Cài: make listen-install
CLAUDE_BIN=claude          # đường dẫn CLI claude (which claude nếu khác)
LISTENER_CLAUDE_ARGS=--dangerously-skip-permissions  # bypass quyền cho daemon tự trị
LISTENER_SKILL=/youtube-auto   # skill cho lệnh /auto
LISTENER_ALLOW_SHELL=true      # cho phép lệnh /sh chạy shell tùy ý (nguy hiểm)

# Cửa sổ runtime từng định dạng — CHỈNH QUA ĐÂY, không sửa code.
# Đo 2026-08-25 trên 60 video đã publish: nhóm <=40s đạt 755 view / 55.4% xem
# hết / 8 trong 16 sub toàn kênh; dải 60-90s chỉ 217 view / 18.4%. Mặc định giữ
# 60-90 để batch đang chạy không đổi hợp đồng giữa chừng.
# Ví dụ thử Short ngắn:  SHORT_VIEWER_MIN_SEC=30 SHORT_VIEWER_MAX_SEC=45 SHORT_MIN_SECTIONS=4
SHORT_VIEWER_MIN_SEC=60
SHORT_VIEWER_MAX_SEC=90
SHORT_MIN_SECTIONS=6
LONG_VIEWER_MIN_SEC=720
LONG_VIEWER_MAX_SEC=900
LONG_MIN_SECTIONS=24
