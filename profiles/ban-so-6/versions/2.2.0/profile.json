{
  "schema_version": 1,
  "profile_id": "ban-so-6",
  "version": "2.2.0",
  "display_name": "Bàn số 6 — Truyện đời thường",
  "topic": "Những lựa chọn nhỏ của Minh và An tại Bàn số 6",
  "narrative_mode": "character_story",
  "prompts": {
    "editorial": "prompts/editorial.md",
    "editorial_review": "prompts/editorial-review.md",
    "spoken_language": "prompts/spoken-language.md",
    "conversation_contract": "prompts/conversation-contract.md",
    "long_transcript_structure": "prompts/long-transcript-structure.md",
    "series_bible": "series-bible.md",
    "visual_bible": "visual-bible.md",
    "season_plan": "season-01.md",
    "continuity": "continuity-ledger-season-02.json"
  },
  "format_prompts": {
    "long": "long_transcript_structure"
  },
  "editorial_review": {
    "enabled": true,
    "rubric_prompt_name": "editorial_review",
    "minimum_score": 9,
    "max_rewrites": 2
  },
  "formats": {
    "short": {
      "viewer_min_sec": 60,
      "viewer_max_sec": 90,
      "min_sections": 4,
      "max_sections": 12
    },
    "long": {
      "viewer_min_sec": 300,
      "viewer_max_sec": 420,
      "runtime_tolerance_sec": 3,
      "min_sections": 10,
      "max_sections": 24
    }
  },
  "providers": {
    "llm": "xkiro",
    "tts": "xkiro",
    "render": "story",
    "broll_strategy": "none",
    "broll_allow_downloads": false,
    "tts_pace_factor": 0.92
  },
  "voice_cast": {
    "narrator": "standard-female-vietnamese",
    "minh": "confident-male-vietnamese",
    "an": "sweet-female-vietnamese"
  },
  "content_rules": {
    "require_pexels_query": false,
    "require_short_source_trace": true,
    "require_conversation_turns": true,
    "narrator_lesson_closing": true,
    "allow_short_generation": true,
    "story_primary_speaker_id": "minh",
    "story_supporting_speaker_id": "an",
    "require_next_episode_bridge": true
  },
  "render": {
    "assets_dir": "assets",
    "show_captions": true,
    "inter_segment_gap_sec": 0.4,
    "transition_overlap_sec": 0.4,
    "scene_assets": [
      "opening.png",
      "recognition.png",
      "empty-outline.png",
      "three-lines.png",
      "reply.png"
    ]
  },
  "visual_generation": {
    "enabled": true,
    "style_prompt": "2D editorial illustration, soft line art, light paper texture, limited animation still, warm muted palette (cream #E9DFC8, navy #26394A, slate teal #667C7A, burnt orange #B96842, brown #5A4032, ochre #D8B26E), no neon, no 3D shading, no exaggerated expression, Vietnamese adults in their early-to-mid thirties, lived-in but not aged faces",
    "negative_prompt": "3d render, glossy, photo, photorealistic, neon, watermark, text, logo, gibberish text, extra fingers, deformed hands, anime eyes, exaggerated expression, comic panel grid, multiple panels, character turnaround sheet, reference sheet, collage, multiple views of same character, model sheet, teenage, early-twenties face, old, aged, deep wrinkles, middle-aged",
    "steps": 30,
    "cfg": 6.5,
    "solo_weight": 0.45,
    "duo_weight": 0.3,
    "duo_denoise": 0.5,
    "candidate_count": 2,
    "selection_policy": "vlm_ranked",
    "candidate_policy_version": "ban-so-6-production-v1",
    "semantic_rejection_recovery": "regenerate_once",
    "visual_judge": {
      "enabled": true,
      "provider": "xkiro",
      "model": "qwen/qwen3.8-max:free",
      "policy_version": "ban-so-6-gate1-v1",
      "minimum_score": 0.5,
      "hard_fail_on_judge_error": true
    },
    "characters": {
      "minh": "identity/minh.png",
      "an": "identity/an.png"
    },
    "duo_reference_image": "recognition.png"
  }
}
